{
  "name": "@ai-fleet/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "aifleet-db": "dist/cli/db.js",
    "aifleet-daemon": "dist/cli/run.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
