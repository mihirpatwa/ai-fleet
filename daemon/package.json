    "commander": "^14.0.3",
    "diff": "^7.0.0",
    "fastify": "^5.8.5",
    "js-yaml": "^4.1.1",
    "p-limit": "^7.3.0",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ulid": "^3.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^7.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.19",
    "tsx": "^4.22.1",
    "vitest": "^2.1.9"
